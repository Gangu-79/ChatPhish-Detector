# ChatPhishDetector Environment Configuration Template
# Copy this file to .env and fill in your API credentials

# OpenAI API Key (Required for GPT-4, GPT-4V, GPT-4o, GPT-3.5)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Azure OpenAI Service (If reproducing the exact Azure setup in Section V-A1)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: Google Gemini API Key (If evaluating Gemini Pro / Gemini Pro Vision)
# GEMINI_API_KEY=

# Optional: Groq API Key (If evaluating open-source Llama 3 70B / Gemma 2 9B as in Section V-C2)
# GROQ_API_KEY=

# Crawler Configuration
CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
CRAWLER_TIMEOUT=30
CRAWLER_HEADLESS=true
